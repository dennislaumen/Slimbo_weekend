{
  "name": "spellenweekend-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:fake": "tsc --noEmit && VITE_FAKE=1 vite build --outDir dist-fake",
    "preview": "vite preview",
    "lint": "eslint src e2e e2e-emulator",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:visual": "playwright test e2e/visual.spec.ts",
    "dev:fake": "VITE_FAKE=1 vite",
    "build:emulator": "tsc --noEmit && VITE_EMULATOR=1 vite build --outDir dist-emulator",
    "test:e2e": "playwright test e2e/flows.spec.ts",
    "test:emulator": "npm run build:emulator && firebase emulators:exec --config ../firebase.json --only auth,firestore --project demo-e2e \"playwright test -c playwright.emulator.config.ts\"",
    "check": "npm run typecheck && npm run lint && npm test && npm run build:fake && npm run test:e2e",
    "check:full": "npm run check && npm run test:visual && npm run test:emulator"
  },
  "dependencies": {
    "firebase": "^13.2.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "firebase-tools": "^15.35.0",
    "globals": "^17.14.0",
    "jsdom": "^30.1.3",
    "pixelmatch": "^8.0.0",
    "pngjs": "^7.0.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vitest": "^5.1.0"
  }
}
